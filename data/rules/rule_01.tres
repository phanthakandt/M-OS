[resource]
script = ExtResource("1")
rule_number = 1
text = "โปรดจงระลึกไว้เสมอว่าข้อมูลทั้งหมดในคอมพิวเตอร์เครื่องนี้เป็นทรัพย์สินส่วนบุคคล ห้ามเปิดไฟล์ใดๆ ก็ตามในเครื่องนี้"
