[ext_resource type="Script" path="res://scripts/resources/blob_data.gd" id="2"]

[sub_resource type="Resource" id="blob1"]
script = ExtResource("2")
id = "readme_meta"
label = "readme.meta  [header block]"

[resource]
script = ExtResource("1")
id = "readme"
filename = "README"
extension = "txt"
content = "[color=#a8484a]คำเตือน: นี่คือขั้นตอนการ Factory Restore M-OS กรุณาทำตามขั้นตอนต่อไปนี้อย่างเคร่งครัด[/color]

[font=res://assets/fonts/PressStart2P-Regular.ttf][color=#cdd8e2]01[/color][/font]
[color=#7d8b9a]โปรดจงระลึกไว้เสมอว่าข้อมูลทั้งหมดในคอมพิวเตอร์เครื่องนี้เป็นทรัพย์สินส่วนบุคคล ห้ามเปิดไฟล์ใดๆ ก็ตามในเครื่องนี้[/color]

[font=res://assets/fonts/PressStart2P-Regular.ttf][color=#cdd8e2]02[/color][/font]
[color=#7d8b9a]เข้าไปที่ drive หาโฟลเดอร์ที่ชื่อว่า system (หากเข้า drive แล้วไม่เจอ ให้คลิก show hidden ก่อน)[/color]

[font=res://assets/fonts/PressStart2P-Regular.ttf][color=#cdd8e2]03[/color][/font]
[color=#7d8b9a]...[/color]

[font=res://assets/fonts/PressStart2P-Regular.ttf][color=#cdd8e2]04[/color][/font]
[color=#7d8b9a]m-os มีระบบป้องกันกดเปิดไฟล์ วิธีการลบจะต้องแกะไฟล์ def.mos ออกมาก่อนผ่านโปรแกรม devcrack[/color]
"
blobs = [SubResource("blob1")]
